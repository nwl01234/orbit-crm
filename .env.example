# ------------------------------------------------------------------ application
APP_NAME=Orbit CRM
APP_TAGLINE=Операционная CRM для команд
ENVIRONMENT=demo
DEBUG=false

# --------------------------------------------------------------------- database
DATABASE_URL=sqlite:///./crm.db

# ------------------------------------------------------------------------ auth
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
COOKIE_SECURE=false
LOGIN_MAX_ATTEMPTS=8
LOGIN_WINDOW_SECONDS=300

# Demo bootstrap account (created only when the users table is empty).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_EMAIL=admin@example.com

# -------------------------------------------------------------------------- AI
# Optional OpenAI-compatible endpoint. Leave AI_BASE_URL empty for rule-based mode.
# Local Ollama:
#   AI_BASE_URL=http://localhost:11434/v1
#   AI_API_KEY=ollama
#   AI_MODEL=llama3.2:1b
#   AI_EMBED_MODEL=nomic-embed-text
# OpenAI:
#   AI_BASE_URL=https://api.openai.com/v1
#   AI_API_KEY=sk-...
#   AI_MODEL=gpt-4o-mini
#   AI_EMBED_MODEL=text-embedding-3-small
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=llama3.2:1b
AI_EMBED_MODEL=nomic-embed-text
AI_TIMEOUT=8
AI_INDEX_ON_STARTUP=false
AI_MAX_CONTEXT_CHARS=12000

# -------------------------------------------------------------------- telegram
# Internal employee bot (not a customer support channel).
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_IDS=
TELEGRAM_NOTIFY_ON_CREATE=true

# ------------------------------------------------------------------------- cors
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
