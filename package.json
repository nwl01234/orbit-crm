{
  "name": "orbit-crm",
  "version": "7.0.0",
  "private": true,
  "description": "Orbit CRM — portfolio-grade operations CRM",
  "scripts": {
    "css:build": "tailwindcss -i ./static/src/app.css -o ./static/app.css --minify",
    "css:watch": "tailwindcss -i ./static/src/app.css -o ./static/app.css --watch",
    "vendor": "node scripts/vendor-assets.mjs",
    "build": "npm run css:build && npm run vendor"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/inter-tight": "^5.3.0",
    "alpinejs": "^3.14.8",
    "tailwindcss": "^3.4.17"
  }
}
